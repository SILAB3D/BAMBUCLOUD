# ---------------------------------------------------------------------------
# Cuenta de Bambu Cloud
# ---------------------------------------------------------------------------
BAMBU_EMAIL=tu@email.com
BAMBU_PASSWORD=tu_password
# global (api.bambulab.com) o china (api.bambulab.cn)
BAMBU_REGION=global

# Opcional: si ya tienes un accessToken valido, saltas el login.
# BAMBU_TOKEN=

# Opcional: si tienes varias impresoras, fija cual seguir.
# Si lo dejas vacio coge la primera de la cuenta.
# PRINTER_SERIAL=

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
# Contrasena para entrar al dashboard. Si la dejas vacia el dashboard es publico.
DASHBOARD_PASSWORD=cambia_esto
# Secreto de sesion. Genera uno con: openssl rand -hex 32
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Notificaciones (todas opcionales, puedes usar varias a la vez)
# ---------------------------------------------------------------------------
# Telegram: habla con @BotFather para el token, y con @userinfobot para tu chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: ajustes del canal -> Integraciones -> Webhooks
DISCORD_WEBHOOK=

# Cualquier otra URL que reciba un POST JSON
GENERIC_WEBHOOK=

# Aviso cada N% de progreso. 0 = desactivado, 25 = avisa al 25/50/75%
NOTIFY_PROGRESS_STEP=0

# ---------------------------------------------------------------------------
# Agente de camara (esto va en el .env de la maquina de TU RED, no del VPS)
# ---------------------------------------------------------------------------
PRINTER_IP=192.168.1.50
PRINTER_ACCESS_CODE=12345678
PRINTER_CAMERA_USER=bblp
DASHBOARD_URL=https://tu-dominio.com
CAMERA_INTERVAL_MS=10000

# Token compartido entre el agente y el servidor. Genera uno con: openssl rand -hex 24
# Ponlo IGUAL en el .env del VPS y en el del agente.
AGENT_TOKEN=
